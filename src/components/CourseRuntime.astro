---
/*
 * Client runtime for the course: grading, hints, gating, progress.
 * Progressive enhancement — every page renders server-side first.
 */
---

<script>
  import { read, recordAttempt, setUnit, subscribe, watchOtherTabs, storageDenied, isSolved, due, reset, pad } from '../scripts/progress';
  import { stateOf, blockedBy, isUnitComplete } from '../scripts/gating';
  import { execute, stop, preloadPython, isRemote, type Outcome } from '../scripts/runners';
  import type { Lang } from '../problems/_types';

  const LANG_KEY = 'dsa-course.lang';

  const preferredLang = (): string => {
    try { return localStorage.getItem(LANG_KEY) || ''; } catch { return ''; }
  };
  const rememberLang = (lang: string) => {
    try { localStorage.setItem(LANG_KEY, lang); } catch { /* not fatal */ }
  };

  // ---- editor behaviour (every language here needs real indentation) -----
  function wireEditor(ta: HTMLTextAreaElement, onSubmit: () => void) {
    const autosize = () => { ta.style.height = 'auto'; ta.style.height = `${ta.scrollHeight}px`; };
    autosize();
    ta.addEventListener('input', autosize);
    ta.addEventListener('keydown', (e) => {
      if (e.key === 'Tab') {
        e.preventDefault();
        const { selectionStart: s, selectionEnd: t, value } = ta;
        if (e.shiftKey) {
          const ls = value.lastIndexOf('\n', s - 1) + 1;
          if (value.slice(ls, ls + 4) === '    ') {
            ta.value = value.slice(0, ls) + value.slice(ls + 4);
            ta.selectionStart = ta.selectionEnd = Math.max(ls, s - 4);
          }
        } else {
          ta.value = `${value.slice(0, s)}    ${value.slice(t)}`;
          ta.selectionStart = ta.selectionEnd = s + 4;
        }
        autosize();
      } else if (e.key === 'Enter' && (e.metaKey || e.ctrlKey)) {
        e.preventDefault();
        onSubmit();
      } else if (e.key === 'Escape') {
        ta.blur();
      }
    });
  }

  /** Wires one language pane of one problem. */
  function wirePane(problemId: string, pane: HTMLElement, onSolved: () => void) {
    const data = JSON.parse(pane.querySelector('.problem-data')!.textContent || '{}');
    const lang: Lang = data.lang;
    const ta = pane.querySelector('.problem-editor') as HTMLTextAreaElement;
    const starter = ta.value;
    const out = pane.querySelector('.problem-out') as HTMLElement;
    const results = pane.querySelector('.problem-results') as HTMLElement;
    const status = pane.querySelector('.problem-status') as HTMLElement;
    const hintBox = pane.querySelector('.problem-hints') as HTMLElement;
    const solution = pane.querySelector('.problem-solution') as HTMLElement;
    const btn = (a: string) => pane.querySelector(`[data-act="${a}"]`) as HTMLButtonElement;

    let hintsShown = 0;
    wireEditor(ta, submit);
    if (isSolved(problemId)) solution.hidden = false;

    const busy = (on: boolean) => {
      btn('submit').disabled = on;
      btn('run').disabled = on;
      btn('stop').hidden = !on || isRemote(lang);
    };

    function writeOut(text: string, err: boolean) {
      out.hidden = false;
      const span = document.createElement('span');
      if (err) span.className = 'runner-err';
      span.textContent = text + '\n';
      out.appendChild(span);
    }

    function clear() {
      out.textContent = ''; out.hidden = true;
      results.textContent = ''; results.hidden = true;
    }

    function waiting(): string {
      if (lang === 'cpp') return 'compiling remotely…';
      if (lang === 'python') return 'starting Python…';
      return 'running…';
    }

    function report(o: Outcome) {
      if (o.kind === 'timeout') { writeOut('⏱ stopped after the time limit — infinite loop?', true); status.textContent = 'stopped'; }
      else if (o.kind === 'error') { writeOut(o.message, true); status.textContent = 'error'; }
      else if (o.kind === 'unavailable') { writeOut(o.message, true); status.textContent = 'unavailable'; }
      else if (o.kind === 'ran') { status.textContent = o.ms ? `ran in ${Math.max(1, Math.round(o.ms))} ms` : 'ran'; }
    }

    async function run() {
      clear(); busy(true); status.textContent = waiting();
      const o = await execute({ lang, code: ta.value, onOutput: writeOut });
      busy(false);
      report(o);
    }

    async function submit() {
      clear(); busy(true); status.textContent = waiting();
      const o = await execute({ lang, code: ta.value, tests: data.tests, onOutput: writeOut });
      busy(false);

      if (o.kind !== 'graded') {
        recordAttempt(problemId, false);
        report(o);
        return;
      }

      results.hidden = false;
      let passed = 0;
      for (const t of o.results) {
        const li = document.createElement('li');
        li.className = t.ok ? 'test-row ok' : 'test-row bad';
        li.innerHTML = `<span class="test-mark">${t.ok ? '✓' : '✗'}</span><span class="test-label"></span>`;
        (li.querySelector('.test-label') as HTMLElement).textContent = t.label;
        if (!t.ok) {
          const d = document.createElement('div');
          d.className = 'test-detail';
          d.textContent = `expected ${t.expected} · got ${t.actual}`;
          li.appendChild(d);
        }
        results.appendChild(li);
        if (t.ok) passed++;
      }

      const allPassed = o.results.length > 0 && passed === o.results.length;
      recordAttempt(problemId, allPassed);
      status.textContent = allPassed
        ? `passed ${passed}/${o.results.length}`
        : `${passed}/${o.results.length} passed`;
      if (allPassed) { solution.hidden = false; onSolved(); }
    }

    pane.addEventListener('click', (e) => {
      const act = (e.target as HTMLElement).closest('button')?.dataset.act;
      if (act === 'submit') submit();
      else if (act === 'run') run();
      else if (act === 'reset') { ta.value = starter; ta.dispatchEvent(new Event('input')); clear(); status.textContent = ''; }
      else if (act === 'stop') { stop(lang); busy(false); writeOut('■ stopped', true); status.textContent = 'stopped'; }
      else if (act === 'hint') {
        if (hintsShown >= data.hints.length) { status.textContent = 'no more hints'; return; }
        hintBox.hidden = false;
        const el = document.createElement('p');
        el.textContent = data.hints[hintsShown++];
        hintBox.appendChild(el);
        if (hintsShown >= data.hints.length) btn('hint').disabled = true;
      }
    });
  }

  function wireProblem(root: HTMLElement) {
    const id = root.dataset.problemId!;
    const panes = [...root.querySelectorAll<HTMLElement>('.lang-pane')];
    const tabs = [...root.querySelectorAll<HTMLElement>('.langtab')];

    const markSolved = () => { root.classList.add('is-solved'); refreshUnit(); };
    if (isSolved(id)) root.classList.add('is-solved');

    panes.forEach((pane) => wirePane(id, pane, markSolved));

    const show = (lang: string) => {
      panes.forEach((p) => { p.hidden = p.dataset.lang !== lang; });
      tabs.forEach((t) => t.setAttribute('aria-selected', String(t.dataset.lang === lang)));
      // Only pay for the Python runtime if Python is actually on screen.
      if (lang === 'python') preloadPython();
    };

    tabs.forEach((t) =>
      t.addEventListener('click', () => {
        const lang = t.dataset.lang!;
        rememberLang(lang);
        // Keep every problem on the page in step with the choice.
        document.querySelectorAll<HTMLElement>('.problem').forEach((other) => {
          const langs: string[] = JSON.parse(other.dataset.langs || '[]');
          if (langs.includes(lang)) other.dispatchEvent(new CustomEvent('setlang', { detail: lang }));
        });
      }),
    );

    root.addEventListener('setlang', (e) => show((e as CustomEvent).detail));

    const langs: string[] = JSON.parse(root.dataset.langs || '[]');
    const want = preferredLang();
    show(langs.includes(want) ? want : langs[0]);
  }

  // ---- ladder rungs ------------------------------------------------------
  function wireRung(rung: HTMLElement) {
    const ladder = rung.closest('.ladder') as HTMLElement;
    const lang = (ladder?.dataset.ladderLang || 'python') as Lang;
    const demo = ladder?.dataset.ladderDemo || '';
    const code = ((rung.querySelector('.rung-code') as HTMLElement).textContent || '') + '\n' + demo;
    const out = rung.querySelector('.rung-out') as HTMLElement;
    const status = rung.querySelector('.rung-status') as HTMLElement;

    rung.querySelector('[data-act="run-rung"]')!.addEventListener('click', async () => {
      out.hidden = false; out.textContent = '';
      status.textContent = lang === 'cpp' ? 'compiling remotely…' : 'running…';
      const o = await execute({
        lang,
        code,
        onOutput: (text, err) => {
          const s = document.createElement('span');
          if (err) s.className = 'runner-err';
          s.textContent = text + '\n';
          out.appendChild(s);
        },
      });
      if (o.kind === 'ran') status.textContent = o.ms ? `${Math.max(1, Math.round(o.ms))} ms` : 'done';
      else if (o.kind === 'timeout') status.textContent = 'stopped at the time limit';
      else if (o.kind === 'error' || o.kind === 'unavailable') {
        status.textContent = o.kind === 'error' ? 'error' : 'unavailable';
        const s = document.createElement('span');
        s.className = 'runner-err';
        s.textContent = o.message + '\n';
        out.appendChild(s);
      }
    });
  }

  // ---- unit gating + completion -----------------------------------------
  let unitMeta: { order: number; requires: number[]; ladder: string; varied: string[]; transfer: string } | null = null;

  function refreshUnit() {
    if (!unitMeta) return;
    const store = read();
    const complete = isUnitComplete(
      { ladder: unitMeta.ladder, varied: unitMeta.varied, transfer: unitMeta.transfer },
      store,
    );
    const id = pad(unitMeta.order);
    const already = store.units[id]?.state;
    if (complete && already !== 'complete') setUnit(id, 'complete');
    else if (!complete && !already) setUnit(id, 'in-progress');

    const banner = document.getElementById('unit-complete');
    if (banner) banner.hidden = !complete;
  }

  function gateUnit() {
    const el = document.getElementById('unit-root') as HTMLElement | null;
    if (!el) return;
    unitMeta = JSON.parse(el.dataset.unit!);
    const store = read();
    const state = stateOf({ order: unitMeta!.order, requires: unitMeta!.requires }, store);
    const body = document.getElementById('unit-body')!;
    const locked = document.getElementById('unit-locked')!;

    if (state === 'locked') {
      locked.hidden = false;
      const names = blockedBy({ order: unitMeta!.order, requires: unitMeta!.requires }, store);
      (locked.querySelector('.locked-list') as HTMLElement).textContent = names.map((n) => `Unit ${pad(n)}`).join(', ');
      const link = locked.querySelector('.locked-link') as HTMLAnchorElement;
      if (names.length) link.href = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/learn/${pad(names[0])}`;
    } else {
      body.hidden = false;
      document.querySelectorAll<HTMLElement>('.problem').forEach(wireProblem);
      document.querySelectorAll<HTMLElement>('.rung').forEach(wireRung);
      refreshUnit();
    }

    locked.querySelector('[data-act="skip"]')?.addEventListener('click', () => {
      const names = blockedBy({ order: unitMeta!.order, requires: unitMeta!.requires }, read());
      names.forEach((n) => setUnit(pad(n), 'skipped'));
      location.reload();
    });
  }

  // ---- map, inventory, review -------------------------------------------
  function paintMap() {
    const cards = document.querySelectorAll<HTMLElement>('[data-unit-card]');
    if (!cards.length) return;
    const store = read();
    cards.forEach((card) => {
      const meta = JSON.parse(card.dataset.unitCard!);
      const state = stateOf(meta, store);
      card.dataset.state = state;
      const pill = card.querySelector('.state-pill') as HTMLElement;
      if (pill) pill.textContent = state === 'in-progress' ? 'in progress' : state;
      if (state === 'locked') card.setAttribute('aria-disabled', 'true');
      else card.removeAttribute('aria-disabled');
    });
    const badge = document.getElementById('due-badge');
    if (badge) {
      const n = due().length;
      badge.textContent = n ? `${n} due` : 'nothing due';
      badge.hidden = false;
    }
  }

  function paintInventory() {
    const rows = document.querySelectorAll<HTMLElement>('[data-inv-unit]');
    if (!rows.length) return;
    const store = read();
    rows.forEach((row) => {
      const s = store.units[pad(Number(row.dataset.invUnit))]?.state;
      row.dataset.state = s === 'complete' ? 'known' : s ? 'learning' : 'locked';
    });
  }

  function noticeStorage() {
    read();
    if (!storageDenied) return;
    const el = document.getElementById('storage-notice');
    if (el) el.hidden = false;
  }

  function init() {
    watchOtherTabs();
    subscribe(() => { paintMap(); paintInventory(); });
    gateUnit();
    paintMap();
    paintInventory();
    noticeStorage();
    document.getElementById('reset-progress')?.addEventListener('click', () => {
      if (confirm('Reset all course progress? This cannot be undone.')) { reset(); location.reload(); }
    });
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init, { once: true });
  else init();
</script>
