---
import { getProblem, langsOf, implOf } from '../problems';
import { LANG_LABEL } from '../problems/_types';

interface Props {
  id: string;
}

const { id } = Astro.props;
const p = getProblem(id);

// One pane per language that actually has a ladder. The runtime shows the one
// matching the selected tab, and says so when it has to fall back.
const ladderLangs = langsOf(p).filter((l) => (p.impls[l]?.ladder?.length ?? 0) > 0);
---

{
  ladderLangs.length > 0 && (
    <section class="ladder">
      <h3>How you get there</h3>
      <p class="small">
        Every rung runs on the same workload, so the times are comparable. Start
        at the top and watch the cost, rather than taking the last one on faith.
      </p>
      <p class="small ladder-note" hidden></p>

      {ladderLangs.map((lang, i) => {
        const impl = implOf(p, lang);
        return (
          <div
            class="ladder-pane"
            data-lang={lang}
            data-lang-label={LANG_LABEL[lang]}
            data-ladder-demo={impl.ladderDemo ?? ''}
            hidden={i !== 0}
          >
            {(impl.ladder ?? []).map((r, n) => (
              <article class="rung">
                <header class="rung-head">
                  <span class="tag">
                    {n + 1} · {r.label}
                  </span>
                  <span class="rung-cost">{r.complexity}</span>
                </header>

                <pre class="rung-code"><code>{r.code}</code></pre>

                <div class="rung-bar">
                  <button class="runbtn" type="button" data-act="run-rung">
                    ▸ Run
                  </button>
                  {r.diesAt && <span class="rung-dies">dies at {r.diesAt}</span>}
                  <span class="rung-status" />
                </div>

                <pre class="rung-out" hidden />

                <p class="rung-insight">{r.insight}</p>
              </article>
            ))}
          </div>
        );
      })}
    </section>
  )
}
