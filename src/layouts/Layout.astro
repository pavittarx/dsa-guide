---
import '../styles/global.css';
import CodeRunner from '../components/CodeRunner.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'DSA in 2026 — a practical guide for when AI writes the code',
  description = "What's still worth learning about data structures and algorithms in 2026, why, and how to practise it so it sticks. Built for interviews and for shipping.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} />
    <title>{title}</title>
  </head>
  <body>
    <div class="wrap">
      <slot />
    </div>
    <CodeRunner />
  </body>
</html>
